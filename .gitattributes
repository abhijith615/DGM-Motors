# Normalise line endings in the repo; check out native on each platform.
* text=auto eol=lf

# Binary assets — never touch these.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.avif binary
*.woff2 binary
*.ico binary

# Keep diffs readable but don't let the lockfile dominate review.
package-lock.json linguist-generated=true -diff
